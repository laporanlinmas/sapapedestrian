# ============================================================

# ── Firebase (WAJIB) ──────────────────────────────────────
# Nilai yang sama dengan project sipedasadmin & sipedas-view.
# Dipakai oleh: /api/* (serverless) dan VisitorCounter + jalur cadangan browser.
VITE_FIREBASE_API_KEY="AIzaSyAUuXTzKNADS9iP3c8Z7QbAfj3Lf8iDcP0"
VITE_FIREBASE_AUTH_DOMAIN="sipedaslinmas.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://sipedaslinmas-default-rtdb.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="sipedaslinmas"
VITE_FIREBASE_STORAGE_BUCKET="sipedaslinmas.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="657713180725"
VITE_FIREBASE_APP_ID="1:657713180725:web:9509e93ecaa995bcaa817c"
VITE_FIREBASE_MEASUREMENT_ID="G-97K224ZG7V"

# Alias tanpa prefix VITE_ — dibaca api/*.ts (serverless).
# Vercel sudah otomatis menyalin VITE_* ke build, tapi nama *_FIREBASE_*
# lebih jelas & tidak bergantung perilaku tersebut.
FIREBASE_API_KEY="AIzaSyAUuXTzKNADS9iP3c8Z7QbAfj3Lf8iDcP0"
FIREBASE_AUTH_DOMAIN="sipedaslinmas.firebaseapp.com"
FIREBASE_DATABASE_URL="https://sipedaslinmas-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_PROJECT_ID="sipedaslinmas"
FIREBASE_STORAGE_BUCKET="sipedaslinmas.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="657713180725"
FIREBASE_APP_ID="1:657713180725:web:9509e93ecaa995bcaa817c"

# ── Cloudinary (WAJIB untuk foto aduan) ───────────────────
# Folder: uploaded ke folder `sapapedestrian_aduan`.
CLOUDINARY_CLOUD_NAME="dym9koebf"
CLOUDINARY_API_KEY="334925144652719"
CLOUDINARY_API_SECRET="z4NzTD0zHdZ7jz8OCsFG588lfhE"

# Unsigned upload preset — dipakai HANYA sebagai jalur cadangan
# ketika serverless function tidak tersedia (upload langsung dari browser).
# Pastikan preset ini disetel "Unsigned" di dashboard Cloudinary.
VITE_CLOUDINARY_CLOUD_NAME="dym9koebf"
VITE_CLOUDINARY_UPLOAD_PRESET="sapapedestrian"

# ── URL Publik ───────────────────────────────────────────
# URL produksi (tanpa garis miring di akhir). Dipakai untuk:
#   robots.txt · sitemap.xml · Open Graph · JSON-LD
# GANTI dengan domain asli Anda sebelum deploy.
VITE_SITE_URL="http://localhost:3001"

VITE_CCTV_URL="https://sipedasview.vercel.app/"
VITE_MYMAPS_VIEWER_URL="https://www.google.com/maps/d/viewer?mid=1TuYzI9pWcS39u6wSyfhySLT6jyO_BNE"
VITE_MYMAPS_EMBED_URL="https://www.google.com/maps/d/embed?mid=1TuYzI9pWcS39u6wSyfhySLT6jyO_BNE&z=15"
VITE_VIDEO_URL="https://player.cloudinary.com/embed/?cloud_name=dym9koebf&public_id=profil_pedestrian_qq1i9h"

# ── Google Drive — Galeri Kegiatan (WAJIB untuk galeri) ───
# Kredensial ini SANGAT SENSITIF (bisa membaca seluruh isi Drive).
#
# ⚠️ JANGAN memakai prefix VITE_ pada variabel di sini. Prefix VITE_ membuat
#    nilainya ikut ter-bundle ke browser dan bocor ke publik. Nama harus
#    persis seperti di bawah agar hanya terbaca di server (api/*.ts).
#
# Nilai ini sama dengan yang dipakai project sipedasadmin.
# Service account juga harus punya akses baca ke folder tersebut.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
FOLDER_UTAMA_ID="1XylKHvGR7Wkmt_i-JsN3ehsa8yVB0sba"

# ── Origin yang boleh memanggil API (opsional, default "*") ─
